{
  "name": "@tinkered/devtools",
  "version": "0.34.13",
  "description": "Tinkered devtools: a plain capsule that keeps a scope's spans, sessions, exits and writes, and gives a snapshot a tool can read.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagz0ne/tinkered.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "size": "vp pack && node ../../scripts/check-size.mjs 2160",
    "dev": "vp pack --watch",
    "test": "vp test",
    "mutate": "stryker run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tinkered/core": "workspace:*",
    "@types/node": "^26.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tinkered/core": "workspace:^"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22.18.0"
  }
}

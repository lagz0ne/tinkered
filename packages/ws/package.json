{
  "name": "@tinker/ws",
  "version": "0.15.0",
  "description": "Tinkered rpc over one WebSocket: a browser or Bun client, and a Bun server.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./server": "./dist/server.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "bun --bun vp test",
    "mutate": "stryker run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tinker/core": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4"
  }
}

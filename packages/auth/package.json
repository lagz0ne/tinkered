  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "1.19.17",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tinker/drizzle": "workspace:*",
    "@tinker/stack": "workspace:*",
    "@types/node": "26.5.1",
    "auth": "1.7.6",
    "drizzle-kit": "catalog:",

{
  "name": "@tinkered/analyze",
  "version": "0.21.0",
  "description": "Tinker's checks: one command reads an app and prints each broken rule with its id and the skill to read.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagz0ne/tinkered.git",
    "directory": "packages/analyze"
  },
  "bin": {
    "tinker-analyze": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "lint"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./lint": "./lint/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "mutate": "stryker run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "typescript-api": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "^26.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.5"
  }
}

    "@tinker/process": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tinker/core": "workspace:*",
    "@tinker/http": "workspace:*",
    "@tinker/process": "workspace:*",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}

{
  "name": "@tinkered/cli",
  "version": "0.30.1",
  "description": "The tinker command: one check that corrects the writer (types, then rules, each finding with its fix from the skill), and the skills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagz0ne/tinkered.git",
    "directory": "packages/cli"
  },
  "bin": {
    "tinker": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "lint",
    "base"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./test": "./dist/test.mjs",
    "./vite": "./dist/vite.mjs",
    "./lint": "./lint/index.mjs",
    "./tsconfig.json": "./base/tsconfig.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "mutate": "stryker run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tanstack/intent": "catalog:",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tinkered/core": "workspace:*",
    "@types/node": "^26.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@tinkered/core": "workspace:^",
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@tinkered/core": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}

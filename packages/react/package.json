    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": ">=18.3"

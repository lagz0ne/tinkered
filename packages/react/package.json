    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"

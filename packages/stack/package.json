    "mutate": "stryker run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@tinker/core": "workspace:*",
    "@tinker/hono": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}

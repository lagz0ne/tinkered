{
  "name": "@tinkered/entry",
  "version": "0.29.1",
  "description": "Tinker's backend entries: a command, a server, and the runtime under them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagz0ne/tinkered.git",
    "directory": "packages/entry"
  },
  "files": [
    "dist"
  ],
  "type": "module",

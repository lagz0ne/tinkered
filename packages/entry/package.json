{
  "name": "@tinkered/entry",
  "version": "0.34.15",
  "description": "Tinker's backend entries: a command, a server, and the runtime under them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagz0ne/tinkered.git",
    "directory": "packages/entry"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "./cmd": {
      "browser": "./dist/not-in-page.mjs",
      "default": "./dist/cmd.mjs"
    },
    "./server": {
      "browser": "./dist/not-in-page.mjs",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "bun --bun vp test",
    "mutate": "stryker run && stryker run stryker.run.config.mjs",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tinkered/bun": "workspace:*",
    "@tinkered/core": "workspace:*"
  },
  "devDependencies": {
    "@hughescr/stryker-bun-runner": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.4"
  }
}

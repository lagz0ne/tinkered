{
  "name": "@tinkered/bun",
  "version": "0.21.1",
  "description": "Tinker on Bun: the host on Bun.serve, rpc over one WebSocket, and Bun's own databases (Bun.SQL, bun:sqlite).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagz0ne/tinkered.git",
    "directory": "packages/bun"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./sql": "./dist/sql.mjs",
    "./sqlite": "./dist/sqlite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "bun --bun vp test",
    "mutate": "stryker run && stryker run stryker.run.config.mjs",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tinkered/core": "workspace:*"
  },
  "devDependencies": {
    "@hughescr/stryker-bun-runner": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4"
  }
}

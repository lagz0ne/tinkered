{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun --bun vp test"
  },
  "mutate": ["src/**/*.ts"],
  "ignorePatterns": ["dist"],
  "tsconfigFile": "tsconfig.stryker-none.json",
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 85
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 2,
  "timeoutMS": 15000
}

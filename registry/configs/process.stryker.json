{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 30000,
  "commandRunner": {
    "command": "vp test"
  },
  "plugins": [],
  "mutate": ["src/process/**/*.ts"],
  "ignorePatterns": ["tsconfig.json", "dist"],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 85
  },
  "tempDirName": ".stryker-tmp",
  "vitest": {
    "configFile": "vite.config.ts",
    "dir": "tests/process"
  },
  "jsonReporter": {
    "fileName": "reports/process/mutation.json"
  }
}

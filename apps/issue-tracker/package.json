{
  "name": "@tinker-issue-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Issue tracker: create, edit, discuss, and triage issues live in two tabs, from CLI and MCP.",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "node --experimental-strip-types ./src/server/main.ts",
    "preview": "node --experimental-strip-types ./src/server/main.ts",
    "start": "node --experimental-strip-types ./src/server/main.ts",
    "tools": "node --experimental-strip-types ./src/tools/main.ts",
    "mcp": "node --experimental-strip-types ./src/tools/main.ts mcp",
    "test": "vp test tests/issues.test.ts tests/tools.test.ts tests/draft.test.ts",
    "test:browser": "node --experimental-strip-types ./tests/browser-proof.ts && vp test tests/browser-helper.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "npm:^1.19.5",
    "@modelcontextprotocol/sdk": "catalog:",
    "@tinker/cli": "workspace:*",
    "@tinker/core": "workspace:*",
    "@tinker/drizzle": "workspace:*",
    "@tinker/harness": "workspace:*",
    "@tinker/hono": "workspace:*",
    "@tinker/http": "workspace:*",
    "@tinker/mcp": "workspace:*",
    "@tinker/react": "workspace:*",
    "@tinker/sync": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "npm:^4.3.4",
    "playwright": "1.55.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}

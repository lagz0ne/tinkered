{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun cmds/dev.ts",
    "build": "rm -rf dist && bun run build:client && bun run build:server && bun run check:client && bun run check:tests",
    "build:client": "bun --bun vp build && bun scripts/embed-client.ts",
    "build:server": "bun build cmds/host.ts cmds/telemetry-worker.ts --compile --bytecode --format=esm --minify --sourcemap=linked --define process.env.NODE_ENV='\"production\"' --metafile=dist/meta.json --outfile dist/server",
    "check:client": "bun scripts/check-client.ts dist/client-meta.json",
    "check:tests": "bun scripts/check-no-tests.ts dist/client-meta.json dist/meta.json",
    "start": "dist/server",
    "typecheck": "bun scripts/embed-client.ts && bun --bun tsc --noEmit",
    "test": "bun --bun vp test",
    "check": "bun run typecheck && bun run test && bun run build",
    "check:style": "bun --bun vp check",
    "check:plain": "bun scripts/check-plain.ts"
  },
  "dependencies": {
    "@preact/signals-react": "^3.12.0",
    "@tanstack/react-router": "1.170.41",
    "@tinker/bun": "workspace:*",
    "@tinker/core": "workspace:*",
    "@tinker/react": "workspace:*",
    "jotai": "^3.0.0",
    "legend2": "npm:@legendapp/state@2.1.15",
    "legend3": "npm:@legendapp/state@3.0.0-beta.48",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "playwright": "1.55.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "tinkerApp": "0.24.6"
}
